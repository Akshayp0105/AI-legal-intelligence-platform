# ==== Backend (FastAPI) ====
# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/lexaidb

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Clerk Authentication (Backend)
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=your_clerk_issuer
CLERK_AUDIENCE=your_clerk_audience

# Supabase Storage (Backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Indian Kanoon API (for precedent search)
INDIAN_KANOON_API_KEY=your_indian_kanoon_api_key

# CORS / Frontend URL
FRONTEND_URL=http://localhost:3000

# Environment
ENVIRONMENT=development

# ==== Frontend (Next.js) ====
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk Authentication (Frontend)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_WEBHOOK_SECRET=whsec_...

# Supabase Storage (Frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Database (for webhook)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/lexaidb
