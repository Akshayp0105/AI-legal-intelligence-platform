root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 100

[*.py]
indent_size = 4
max_line_length = 88

[*.md]
trim_trailing_whitespace = false

[Dockerfile]
indent_size = 4

[*.json]
indent_size = 2

[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

[Makefile]
indent_style = tab

[*.ts]
indent_size = 2

[*.tsx]
indent_size = 2

[*.css]
indent_size = 2

[*.html]
indent_size = 2

[*.toml]
indent_size = 4

[*.ini]
indent_size = 4
